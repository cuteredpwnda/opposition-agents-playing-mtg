  <mtg:Keyword rdf:about="http://purl.org/mtg/ontology#Conjure">
    <rdfs:label>Conjure</rdfs:label>
    <mtg:keywordType>card_creation</mtg:keywordType>
    <mtg:implementationStatus>not_planned</mtg:implementationStatus>
  </mtg:Keyword>

  <mtg:Keyword rdf:about="http://purl.org/mtg/ontology#Landwalk">
    <rdfs:label>Landwalk (legacy evasion)</rdfs:label>
    <mtg:keywordType>evasion</mtg:keywordType>
    <mtg:implementationStatus>not_planned</mtg:implementationStatus>
  </mtg:Keyword>

  <!-- ======================================================================== -->
  <!-- SPECIAL ACTIONS (CR 116)                                                 -->
  <!-- ======================================================================== -->

  <owl:Class rdf:about="http://purl.org/mtg/ontology#SpecialAction">
    <rdfs:comment>Special actions don't use the stack (CR 116).</rdfs:comment>
    <mtg:crRule>116</mtg:crRule>
  </owl:Class>

  <mtg:SpecialAction rdf:about="http://purl.org/mtg/ontology#CycleAction">
    <rdfs:label>Cycle a Card</rdfs:label>
    <mtg:crRule>702.32</mtg:crRule>
    <mtg:implementationStatus>implemented</mtg:implementationStatus>
  </mtg:SpecialAction>

  <mtg:SpecialAction rdf:about="http://purl.org/mtg/ontology#TurnFaceUpAction">
    <rdfs:label>Turn a Morph Face Up</rdfs:label>
    <mtg:crRule>702.37</mtg:crRule>
    <mtg:implementationStatus>not_planned</mtg:implementationStatus>
  </mtg:SpecialAction>

  <!-- ======================================================================== -->
  <!-- ZONE TRANSITION OBJECT PROPERTIES                                        -->
  <!-- ======================================================================== -->

  <owl:ObjectProperty rdf:about="http://purl.org/mtg/ontology#triggersOn">
    <rdfs:domain rdf:resource="http://purl.org/mtg/ontology#TriggeredAbility"/>
    <rdfs:range rdf:resource="http://purl.org/mtg/ontology#TriggerEvent"/>
    <rdfs:comment>Links a triggered ability to its trigger event.</rdfs:comment>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://purl.org/mtg/ontology#hasCounter">
    <rdfs:domain rdf:resource="http://purl.org/mtg/ontology#Card"/>
    <rdfs:range rdf:resource="http://purl.org/mtg/ontology#CounterType"/>
    <rdfs:comment>This permanent has counters of the given type.</rdfs:comment>
  </owl:ObjectProperty>

  <owl:DatatypeProperty rdf:about="http://purl.org/mtg/ontology#counterCount">
    <rdfs:domain rdf:resource="http://purl.org/mtg/ontology#Card"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
    <rdfs:comment>Number of counters of a given type on this permanent.</rdfs:comment>
  </owl:DatatypeProperty>

  <!-- ======================================================================== -->
  <!-- JUDGE / RULINGS LAYER                                                    -->
  <!-- ======================================================================== -->

  <owl:Class rdf:about="http://purl.org/mtg/ontology#Ruling">
    <rdfs:comment>An official Wizards ruling or errata, indexed by oracle_id.</rdfs:comment>
  </owl:Class>

  <owl:DatatypeProperty rdf:about="http://purl.org/mtg/ontology#rulingComment">
    <rdfs:domain rdf:resource="http://purl.org/mtg/ontology#Ruling"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="http://purl.org/mtg/ontology#rulingPublishedAt">
    <rdfs:domain rdf:resource="http://purl.org/mtg/ontology#Ruling"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
  </owl:DatatypeProperty>

  <owl:ObjectProperty rdf:about="http://purl.org/mtg/ontology#rulingAppliesTo">
    <rdfs:domain rdf:resource="http://purl.org/mtg/ontology#Ruling"/>
    <rdfs:range rdf:resource="http://purl.org/mtg/ontology#Card"/>
  </owl:ObjectProperty>

  <!-- ======================================================================== -->
  <!-- LLM AGENT METADATA                                                       -->
  <!-- ======================================================================== -->

  <owl:Class rdf:about="http://purl.org/mtg/ontology#Agent">
    <rdfs:comment>A decision-maker controlling a player slot.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="http://purl.org/mtg/ontology#LLMAgent">
    <rdfs:subClassOf rdf:resource="http://purl.org/mtg/ontology#Agent"/>
    <rdfs:comment>An agent backed by a local LLM (e.g. via Ollama).</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="http://purl.org/mtg/ontology#RandomAgent">
    <rdfs:subClassOf rdf:resource="http://purl.org/mtg/ontology#Agent"/>
  </owl:Class>
  <owl:Class rdf:about="http://purl.org/mtg/ontology#HeuristicAgent">
    <rdfs:subClassOf rdf:resource="http://purl.org/mtg/ontology#Agent"/>
  </owl:Class>

  <owl:DatatypeProperty rdf:about="http://purl.org/mtg/ontology#modelName">
    <rdfs:domain rdf:resource="http://purl.org/mtg/ontology#LLMAgent"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment>Ollama model identifier (e.g. "gemma4:e2b").</rdfs:comment>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="http://purl.org/mtg/ontology#modelParamsB">
    <rdfs:domain rdf:resource="http://purl.org/mtg/ontology#LLMAgent"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdfs:comment>Parameter count in billions.</rdfs:comment>
  </owl:DatatypeProperty>

</rdf:RDF>
