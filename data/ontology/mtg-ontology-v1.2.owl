<?xml version="1.0" encoding="UTF-8"?>
<!--
  MTG Ontology v1.2 — Implementation-Calibrated Extension
  ========================================================
  Adds taxonomy for everything the engine actually models or has on
  the near-term roadmap. Sourced from oracle-text mining over 37k
  Scryfall cards (see reports/mechanics.md) and current code in
  src/engine/. v1.1 remains the authoritative parent; v1.2 imports
  it and only adds new classes, properties, individuals.

  Highlights vs v1.1:
    - 25+ keyword individuals: Cycling, Landfall, Prowess, Ward, Scry,
      Surveil, Kicker, Flashback, Crew, Equip, Morph, Investigate,
      Defender, Haste, Indestructible, Hexproof (already partial),
      Protection, Partner, Mill, Treasure, Food, Conjure, Lord,
      Anthem, Tribal.
    - CounterType taxonomy with 14 named subclasses.
    - ReplacementEffect subclasses: EntersTapped, WouldInstead,
      SkipStep, DamagePrevention.
    - TriggeredAbility subclasses: ETBTrigger, DiesTrigger,
      AttackTrigger, BlockTrigger, CastTrigger, UpkeepTrigger,
      EndStepTrigger, DrawStepTrigger, DamageTrigger, LifeGainTrigger,
      LandfallTrigger.
    - SpecialAction class + Cycle individual.
    - implementationStatus property on every Keyword / Trigger / Effect
      with values "implemented" | "partial" | "planned" | "not_planned".
-->
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xmlns:mtg="http://purl.org/mtg/ontology#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#">

  <owl:Ontology rdf:about="http://purl.org/mtg/ontology/v1.2">
    <rdfs:label>Magic: The Gathering OWL Ontology v1.2 (Implementation-Calibrated)</rdfs:label>
    <rdfs:comment>
      Extends v1.1 with the keyword/counter/trigger taxonomy actually
      observed in the Scryfall card pool plus implementation-status
      flags for engine coverage tracking.
    </rdfs:comment>
    <owl:versionInfo>1.2.0</owl:versionInfo>
    <owl:imports rdf:resource="http://purl.org/mtg/ontology"/>
  </owl:Ontology>

  <!-- ======================================================================== -->
  <!-- METADATA: implementation-status property                                  -->
  <!-- ======================================================================== -->

  <owl:DatatypeProperty rdf:about="http://purl.org/mtg/ontology#implementationStatus">
    <rdfs:comment>
      Engine coverage flag: "implemented" | "partial" | "planned" | "not_planned".
      Used by the roadmap renderer to compute coverage % per category.
    </rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="http://purl.org/mtg/ontology#cardCoveragePct">
    <rdfs:comment>Fraction of Scryfall cards (0.0-1.0) whose oracle text matches this mechanic.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="http://purl.org/mtg/ontology#crRule">
    <rdfs:comment>Comprehensive Rules section (e.g. "702.32" for Cycling).</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>

