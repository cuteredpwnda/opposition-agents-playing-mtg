<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xmlns:mtg="http://purl.org/mtg/ontology#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#">

  <owl:Ontology rdf:about="http://purl.org/mtg/ontology">
    <rdfs:label>Magic: The Gathering OWL Ontology v1.1 (Extended)</rdfs:label>
    <rdfs:comment>Extended ontology with game rules, comprehensive ability system, and strategic knowledge</rdfs:comment>
    <owl:versionInfo>1.1.0</owl:versionInfo>
    <owl:imports rdf:resource="http://www.w3.org/2002/07/owl#"/>
  </owl:Ontology>

  <!-- ============================================================================== -->
  <!-- LAYER 1: CORE GAME CONCEPTS -->
  <!-- ============================================================================== -->

  <owl:Class rdf:about="http://purl.org/mtg/ontology#Game"/>
  <owl:Class rdf:about="http://purl.org/mtg/ontology#Player"/>
  <owl:Class rdf:about="http://purl.org/mtg/ontology#Card"/>
  <owl:Class rdf:about="http://purl.org/mtg/ontology#Turn"/>
  <owl:Class rdf:about="http://purl.org/mtg/ontology#Phase"/>
  <owl:Class rdf:about="http://purl.org/mtg/ontology#Zone"/>

  <owl:Class rdf:about="http://purl.org/mtg/ontology#Zone">
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="http://purl.org/mtg/ontology#zoneName"/>
        <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
      </owl:Restriction>
    </rdfs:subClassOf>
  </owl:Class>

  <!-- Zone instances: Library, Hand, Battlefield, Graveyard, Exile, Stack, Command Zone -->
  <mtg:Zone rdf:about="http://purl.org/mtg/ontology#Library">
    <rdfs:label>Library</rdfs:label>
    <mtg:zoneName>library</mtg:zoneName>
  </mtg:Zone>
  <mtg:Zone rdf:about="http://purl.org/mtg/ontology#Hand">
    <rdfs:label>Hand</rdfs:label>
    <mtg:zoneName>hand</mtg:zoneName>
  </mtg:Zone>
  <mtg:Zone rdf:about="http://purl.org/mtg/ontology#Battlefield">
    <rdfs:label>Battlefield</rdfs:label>
    <mtg:zoneName>battlefield</mtg:zoneName>
  </mtg:Zone>
  <mtg:Zone rdf:about="http://purl.org/mtg/ontology#Graveyard">
    <rdfs:label>Graveyard</rdfs:label>
    <mtg:zoneName>graveyard</mtg:zoneName>
  </mtg:Zone>
  <mtg:Zone rdf:about="http://purl.org/mtg/ontology#Exile">
    <rdfs:label>Exile</rdfs:label>
    <mtg:zoneName>exile</mtg:zoneName>
  </mtg:Zone>
  <mtg:Zone rdf:about="http://purl.org/mtg/ontology#Stack">
    <rdfs:label>Stack</rdfs:label>
    <mtg:zoneName>stack</mtg:zoneName>
  </mtg:Zone>
  <mtg:Zone rdf:about="http://purl.org/mtg/ontology#CommandZone">
    <rdfs:label>Command Zone</rdfs:label>
    <mtg:zoneName>command_zone</mtg:zoneName>
  </mtg:Zone>

  <!-- Phases (Turn structure) -->
  <owl:Class rdf:about="http://purl.org/mtg/ontology#Phase">
    <rdfs:comment>Turn phases in order: Untap, Upkeep, Draw, Main 1, Combat, Main 2, End Step, Cleanup</rdfs:comment>
  </owl:Class>
  <mtg:Phase rdf:about="http://purl.org/mtg/ontology#Untap"><rdfs:label>Untap Step</rdfs:label></mtg:Phase>
  <mtg:Phase rdf:about="http://purl.org/mtg/ontology#Upkeep"><rdfs:label>Upkeep</rdfs:label></mtg:Phase>
  <mtg:Phase rdf:about="http://purl.org/mtg/ontology#Draw"><rdfs:label>Draw Step</rdfs:label></mtg:Phase>
  <mtg:Phase rdf:about="http://purl.org/mtg/ontology#Main1"><rdfs:label>Main Phase 1</rdfs:label></mtg:Phase>
  <mtg:Phase rdf:about="http://purl.org/mtg/ontology#CombatBegin"><rdfs:label>Beginning of Combat</rdfs:label></mtg:Phase>
  <mtg:Phase rdf:about="http://purl.org/mtg/ontology#CombatDeclare"><rdfs:label>Declare Attackers</rdfs:label></mtg:Phase>
  <mtg:Phase rdf:about="http://purl.org/mtg/ontology#CombatBlockers"><rdfs:label>Declare Blockers</rdfs:label></mtg:Phase>
  <mtg:Phase rdf:about="http://purl.org/mtg/ontology#CombatDamage"><rdfs:label>Combat Damage</rdfs:label></mtg:Phase>
  <mtg:Phase rdf:about="http://purl.org/mtg/ontology#CombatEnd"><rdfs:label>End of Combat</rdfs:label></mtg:Phase>
  <mtg:Phase rdf:about="http://purl.org/mtg/ontology#Main2"><rdfs:label>Main Phase 2</rdfs:label></mtg:Phase>
  <mtg:Phase rdf:about="http://purl.org/mtg/ontology#EndStep"><rdfs:label>End Step</rdfs:label></mtg:Phase>
  <mtg:Phase rdf:about="http://purl.org/mtg/ontology#Cleanup"><rdfs:label>Cleanup</rdfs:label></mtg:Phase>

  <!-- Mana colors -->
  <owl:Class rdf:about="http://purl.org/mtg/ontology#Color"/>
  <mtg:Color rdf:about="http://purl.org/mtg/ontology#White"><rdfs:label>White</rdfs:label><mtg:colorSymbol>W</mtg:colorSymbol></mtg:Color>
  <mtg:Color rdf:about="http://purl.org/mtg/ontology#Blue"><rdfs:label>Blue</rdfs:label><mtg:colorSymbol>U</mtg:colorSymbol></mtg:Color>
  <mtg:Color rdf:about="http://purl.org/mtg/ontology#Black"><rdfs:label>Black</rdfs:label><mtg:colorSymbol>B</mtg:colorSymbol></mtg:Color>
  <mtg:Color rdf:about="http://purl.org/mtg/ontology#Red"><rdfs:label>Red</rdfs:label><mtg:colorSymbol>R</mtg:colorSymbol></mtg:Color>
  <mtg:Color rdf:about="http://purl.org/mtg/ontology#Green"><rdfs:label>Green</rdfs:label><mtg:colorSymbol>G</mtg:colorSymbol></mtg:Color>
  <mtg:Color rdf:about="http://purl.org/mtg/ontology#Colorless"><rdfs:label>Colorless</rdfs:label><mtg:colorSymbol>C</mtg:colorSymbol></mtg:Color>

  <!-- ============================================================================== -->
  <!-- LAYER 2: CARD TYPES AND PROPERTIES -->
  <!-- ============================================================================== -->

  <owl:Class rdf:about="http://purl.org/mtg/ontology#CardType">
    <rdfs:comment>Main card types: Land, Creature, Instant, Sorcery, Artifact, Enchantment, Planeswalker, Battle</rdfs:comment>
  </owl:Class>

  <mtg:CardType rdf:about="http://purl.org/mtg/ontology#Land"><rdfs:label>Land</rdfs:label></mtg:CardType>
  <mtg:CardType rdf:about="http://purl.org/mtg/ontology#Creature"><rdfs:label>Creature</rdfs:label></mtg:CardType>
  <mtg:CardType rdf:about="http://purl.org/mtg/ontology#Instant"><rdfs:label>Instant</rdfs:label></mtg:CardType>
  <mtg:CardType rdf:about="http://purl.org/mtg/ontology#Sorcery"><rdfs:label>Sorcery</rdfs:label></mtg:CardType>
  <mtg:CardType rdf:about="http://purl.org/mtg/ontology#Artifact"><rdfs:label>Artifact</rdfs:label></mtg:CardType>
  <mtg:CardType rdf:about="http://purl.org/mtg/ontology#Enchantment"><rdfs:label>Enchantment</rdfs:label></mtg:CardType>
  <mtg:CardType rdf:about="http://purl.org/mtg/ontology#Planeswalker"><rdfs:label>Planeswalker</rdfs:label></mtg:CardType>
  <mtg:CardType rdf:about="http://purl.org/mtg/ontology#Battle"><rdfs:label>Battle</rdfs:label></mtg:CardType>

  <!-- Card properties -->
  <owl:DatatypeProperty rdf:about="http://purl.org/mtg/ontology#cardName">
    <rdfs:domain rdf:resource="http://purl.org/mtg/ontology#Card"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="http://purl.org/mtg/ontology#manaCost">
    <rdfs:domain rdf:resource="http://purl.org/mtg/ontology#Card"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment>Mana cost as string: {2}{W}{U} etc.</rdfs:comment>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="http://purl.org/mtg/ontology#convertedManaCost">
    <rdfs:domain rdf:resource="http://purl.org/mtg/ontology#Card"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
    <rdfs:comment>Total mana cost as integer</rdfs:comment>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="http://purl.org/mtg/ontology#oracleText">
    <rdfs:domain rdf:resource="http://purl.org/mtg/ontology#Card"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment>Official ability text</rdfs:comment>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="http://purl.org/mtg/ontology#power">
    <rdfs:domain rdf:resource="http://purl.org/mtg/ontology#Card"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment>Creature power (can be * or expression)</rdfs:comment>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="http://purl.org/mtg/ontology#toughness">
    <rdfs:domain rdf:resource="http://purl.org/mtg/ontology#Card"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment>Creature toughness (can be * or expression)</rdfs:comment>
  </owl:DatatypeProperty>

  <!-- ============================================================================== -->
  <!-- LAYER 3: ABILITY SYSTEM (cr:601) -->
  <!-- ============================================================================== -->

  <owl:Class rdf:about="http://purl.org/mtg/ontology#Ability">
    <rdfs:comment>All abilities: Activated (CR 602), Triggered (CR 603), Static (CR 604), Special (CR 605)</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="http://purl.org/mtg/ontology#ActivatedAbility">
    <rdfs:subClassOf rdf:resource="http://purl.org/mtg/ontology#Ability"/>
    <rdfs:comment>Can be activated by player (cost + effect)</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="http://purl.org/mtg/ontology#TriggeredAbility">
    <rdfs:subClassOf rdf:resource="http://purl.org/mtg/ontology#Ability"/>
    <rdfs:comment>Triggered by game events (whenever, at, when)</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="http://purl.org/mtg/ontology#StaticAbility">
    <rdfs:subClassOf rdf:resource="http://purl.org/mtg/ontology#Ability"/>
    <rdfs:comment>Always affects game (layer system, CR 611)</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="http://purl.org/mtg/ontology#SpecialAbility">
    <rdfs:subClassOf rdf:resource="http://purl.org/mtg/ontology#Ability"/>
    <rdfs:comment>Special actions, land abilities, etc.</rdfs:comment>
  </owl:Class>

  <!-- ============================================================================== -->
  <!-- LAYER 4: KEYWORD ABILITIES (COMPREHENSIVE) -->
  <!-- ============================================================================== -->

  <owl:Class rdf:about="http://purl.org/mtg/ontology#Keyword">
    <rdfs:comment>Keyword abilities: Flying, Evasion, Removal, etc.</rdfs:comment>
  </owl:Class>

  <!-- EVASION KEYWORDS -->
  <mtg:Keyword rdf:about="http://purl.org/mtg/ontology#Flying">
    <rdfs:label>Flying</rdfs:label>
    <mtg:keywordType>evasion</mtg:keywordType>
    <rdfs:comment>Can only be blocked by creatures with flying or reach</rdfs:comment>
  </mtg:Keyword>

  <mtg:Keyword rdf:about="http://purl.org/mtg/ontology#Shadow">
    <rdfs:label>Shadow</rdfs:label>
    <mtg:keywordType>evasion</mtg:keywordType>
    <rdfs:comment>Can only be blocked by creatures with shadow</rdfs:comment>
  </mtg:Keyword>

  <mtg:Keyword rdf:about="http://purl.org/mtg/ontology#Unblockable">
    <rdfs:label>Unblockable</rdfs:label>
    <mtg:keywordType>evasion</mtg:keywordType>
    <rdfs:comment>Cannot be blocked</rdfs:comment>
  </mtg:Keyword>

  <mtg:Keyword rdf:about="http://purl.org/mtg/ontology#Shroud">
    <rdfs:label>Shroud</rdfs:label>
    <mtg:keywordType>protection</mtg:keywordType>
    <rdfs:comment>Cannot be the target of spells or abilities</rdfs:comment>
  </mtg:Keyword>

  <mtg:Keyword rdf:about="http://purl.org/mtg/ontology#Hexproof">
    <rdfs:label>Hexproof</rdfs:label>
    <mtg:keywordType>protection</mtg:keywordType>
    <rdfs:comment>Cannot be the target of spells or abilities your opponents control</rdfs:comment>
  </mtg:Keyword>

  <!-- COMBAT KEYWORDS -->
  <mtg:Keyword rdf:about="http://purl.org/mtg/ontology#Menace">
    <rdfs:label>Menace</rdfs:label>
    <mtg:keywordType>combat</mtg:keywordType>
    <rdfs:comment>Cannot be blocked except by 2+ creatures</rdfs:comment>
  </mtg:Keyword>

  <mtg:Keyword rdf:about="http://purl.org/mtg/ontology#Vigilance">
    <rdfs:label>Vigilance</rdfs:label>
    <mtg:keywordType>combat</mtg:keywordType>
    <rdfs:comment>Does not tap when attacking</rdfs:comment>
  </mtg:Keyword>

  <mtg:Keyword rdf:about="http://purl.org/mtg/ontology#Reach">
    <rdfs:label>Reach</rdfs:label>
    <mtg:keywordType>combat</mtg:keywordType>
    <rdfs:comment>Can block creatures with flying</rdfs:comment>
  </mtg:Keyword>

  <mtg:Keyword rdf:about="http://purl.org/mtg/ontology#FirstStrike">
    <rdfs:label>First Strike</rdfs:label>
    <mtg:keywordType>combat</mtg:keywordType>
    <rdfs:comment>Deals combat damage before normal combat damage</rdfs:comment>
  </mtg:Keyword>

  <mtg:Keyword rdf:about="http://purl.org/mtg/ontology#DoubleStrike">
    <rdfs:label>Double Strike</rdfs:label>
    <mtg:keywordType>combat</mtg:keywordType>
    <rdfs:comment>Deals combat damage twice</rdfs:comment>
  </mtg:Keyword>

  <!-- LIFE KEYWORDS -->
  <mtg:Keyword rdf:about="http://purl.org/mtg/ontology#Lifelink">
    <rdfs:label>Lifelink</rdfs:label>
    <mtg:keywordType>life</mtg:keywordType>
    <rdfs:comment>Damage dealt heals controller</rdfs:comment>
  </mtg:Keyword>

  <!-- EVASION/REMOVAL KEYWORDS -->
  <mtg:Keyword rdf:about="http://purl.org/mtg/ontology#Deathtouch">
    <rdfs:label>Deathtouch</rdfs:label>
    <mtg:keywordType>removal</mtg:keywordType>
    <rdfs:comment>All damage is lethal</rdfs:comment>
  </mtg:Keyword>

  <mtg:Keyword rdf:about="http://purl.org/mtg/ontology#Trample">
    <rdfs:label>Trample</rdfs:label>
    <mtg:keywordType>combat</mtg:keywordType>
    <rdfs:comment>Excess combat damage carries over to defending player</rdfs:comment>
  </mtg:Keyword>

  <mtg:Keyword rdf:about="http://purl.org/mtg/ontology#Flash">
    <rdfs:label>Flash</rdfs:label>
    <mtg:keywordType>timing</mtg:keywordType>
    <rdfs:comment>Can be cast at instant speed</rdfs:comment>
  </mtg:Keyword>

  <!-- CARD DRAW KEYWORDS -->
  <mtg:Keyword rdf:about="http://purl.org/mtg/ontology#Draw">
    <rdfs:label>Draw</rdfs:label>
    <mtg:keywordType>draw</mtg:keywordType>
    <rdfs:comment>Draw cards from library</rdfs:comment>
  </mtg:Keyword>

  <mtg:Keyword rdf:about="http://purl.org/mtg/ontology#Ramp">
    <rdfs:label>Ramp</rdfs:label>
    <mtg:keywordType>acceleration</mtg:keywordType>
    <rdfs:comment>Accelerate mana production</rdfs:comment>
  </mtg:Keyword>

  <!-- ============================================================================== -->
  <!-- LAYER 5: GAME EFFECTS AND MECHANISMS -->
  <!-- ============================================================================== -->

  <owl:Class rdf:about="http://purl.org/mtg/ontology#Effect">
    <rdfs:comment>What a spell or ability does</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="http://purl.org/mtg/ontology#ReplacementEffect">
    <rdfs:subClassOf rdf:resource="http://purl.org/mtg/ontology#Effect"/>
    <rdfs:comment>Modifies or prevents events (CR 614)</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="http://purl.org/mtg/ontology#ContinuousEffect">
    <rdfs:subClassOf rdf:resource="http://purl.org/mtg/ontology#Effect"/>
    <rdfs:comment>Ongoing game state changes (CR 611, layers 1-7)</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="http://purl.org/mtg/ontology#OneTimeEffect">
    <rdfs:subClassOf rdf:resource="http://purl.org/mtg/ontology#Effect"/>
    <rdfs:comment>Happens once, then resolves</rdfs:comment>
  </owl:Class>

  <!-- Trigger events (CR 603.2) -->
  <owl:Class rdf:about="http://purl.org/mtg/ontology#TriggerEvent">
    <rdfs:comment>Events that trigger abilities</rdfs:comment>
  </owl:Class>

  <mtg:TriggerEvent rdf:about="http://purl.org/mtg/ontology#ZoneChange">
    <rdfs:label>Zone Change</rdfs:label>
    <rdfs:comment>Card enters/leaves a zone (ETB, dies, discarded, etc.)</rdfs:comment>
  </mtg:TriggerEvent>

  <mtg:TriggerEvent rdf:about="http://purl.org/mtg/ontology#Combat">
    <rdfs:label>Combat Event</rdfs:label>
    <rdfs:comment>Attacks, blocks, deals damage</rdfs:comment>
  </mtg:TriggerEvent>

  <mtg:TriggerEvent rdf:about="http://purl.org/mtg/ontology#ManaProduction">
    <rdfs:label>Mana Produced</rdfs:label>
    <rdfs:comment>Player produces mana</rdfs:comment>
  </mtg:TriggerEvent>

  <mtg:TriggerEvent rdf:about="http://purl.org/mtg/ontology#SpellCast">
    <rdfs:label>Spell Cast</rdfs:label>
    <rdfs:comment>Player casts a spell</rdfs:comment>
  </mtg:TriggerEvent>

  <mtg:TriggerEvent rdf:about="http://purl.org/mtg/ontology#DamageDealt">
    <rdfs:label>Damage Dealt</rdfs:label>
    <rdfs:comment>A source deals damage</rdfs:comment>
  </mtg:TriggerEvent>

  <!-- ============================================================================== -->
  <!-- LAYER 6: STRATEGIC KNOWLEDGE -->
  <!-- ============================================================================== -->

  <owl:Class rdf:about="http://purl.org/mtg/ontology#Combo">
    <rdfs:comment>Set of cards that produce unlimited value or immediate win</rdfs:comment>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="http://purl.org/mtg/ontology#hasPiece"/>
        <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</owl:minCardinality>
      </owl:Restriction>
    </rdfs:subClassOf>
  </owl:Class>

  <owl:ObjectProperty rdf:about="http://purl.org/mtg/ontology#hasPiece">
    <rdfs:domain rdf:resource="http://purl.org/mtg/ontology#Combo"/>
    <rdfs:range rdf:resource="http://purl.org/mtg/ontology#Card"/>
  </owl:ObjectProperty>

  <owl:Class rdf:about="http://purl.org/mtg/ontology#Synergy">
    <rdfs:comment>Pair or group of cards that work well together</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="http://purl.org/mtg/ontology#Archetype">
    <rdfs:comment>Deck strategy type: Control, Midrange, Aggro, Combo, Ramp, etc.</rdfs:comment>
  </owl:Class>

  <mtg:Archetype rdf:about="http://purl.org/mtg/ontology#Aggro">
    <rdfs:label>Aggro</rdfs:label>
    <mtg:description>Fast creatures, early damage, tempo-based</mtg:description>
  </mtg:Archetype>

  <mtg:Archetype rdf:about="http://purl.org/mtg/ontology#Midrange">
    <rdfs:label>Midrange</rdfs:label>
    <mtg:description>Medium-sized creatures, some removal, balanced strategy</mtg:description>
  </mtg:Archetype>

  <mtg:Archetype rdf:about="http://purl.org/mtg/ontology#Control">
    <rdfs:label>Control</rdfs:label>
    <mtg:description>Removal, counters, board wipes, card draw</mtg:description>
  </mtg:Archetype>

  <mtg:Archetype rdf:about="http://purl.org/mtg/ontology#Combo">
    <rdfs:label>Combo</rdfs:label>
    <mtg:description>Assembles winning combinations of cards</mtg:description>
  </mtg:Archetype>

  <mtg:Archetype rdf:about="http://purl.org/mtg/ontology#Ramp">
    <rdfs:label>Ramp</rdfs:label>
    <mtg:description>Mana acceleration, big threats, go-wide strategies</mtg:description>
  </mtg:Archetype>

  <owl:Class rdf:about="http://purl.org/mtg/ontology#WinCondition">
    <rdfs:comment>How a player wins the game</rdfs:comment>
  </owl:Class>

  <mtg:WinCondition rdf:about="http://purl.org/mtg/ontology#DamageToZero">
    <rdfs:label>Damage to Zero</rdfs:label>
    <rdfs:comment>Reduce opponent life to 0</rdfs:comment>
  </mtg:WinCondition>

  <mtg:WinCondition rdf:about="http://purl.org/mtg/ontology#InfiniteCombo">
    <rdfs:label>Infinite Combo</rdfs:label>
    <rdfs:comment>Assemble infinite loop for mana/draw/damage</rdfs:comment>
  </mtg:WinCondition>

  <mtg:WinCondition rdf:about="http://purl.org/mtg/ontology#CommanderDamage">
    <rdfs:label>Commander Damage</rdfs:label>
    <rdfs:comment>Deal 21+ commander damage (Commander format)</rdfs:comment>
  </mtg:WinCondition>

  <mtg:WinCondition rdf:about="http://purl.org/mtg/ontology#LabManiac">
    <rdfs:label>Lab Maniac Effect</rdfs:label>
    <rdfs:comment>Draw from empty deck via card effect (Alternative Win)</rdfs:comment>
  </mtg:WinCondition>

  <!-- ============================================================================== -->
  <!-- LAYER 7: GAME STATE & BELIEF TRACKING (NEW) -->
  <!-- ============================================================================== -->

  <owl:Class rdf:about="http://purl.org/mtg/ontology#Decklist">
    <rdfs:comment>Known composition of a player's deck</rdfs:comment>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="http://purl.org/mtg/ontology#hasCard"/>
        <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">60</owl:minCardinality>
      </owl:Restriction>
    </rdfs:subClassOf>
  </owl:Class>

  <owl:ObjectProperty rdf:about="http://purl.org/mtg/ontology#hasCard">
    <rdfs:domain rdf:resource="http://purl.org/mtg/ontology#Decklist"/>
    <rdfs:range rdf:resource="http://purl.org/mtg/ontology#Card"/>
  </owl:ObjectProperty>

  <owl:DatatypeProperty rdf:about="http://purl.org/mtg/ontology#cardCount">
    <rdfs:domain rdf:resource="http://purl.org/mtg/ontology#Decklist"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
    <rdfs:comment>Copies of card in decklist (0-4)</rdfs:comment>
  </owl:DatatypeProperty>

  <owl:Class rdf:about="http://purl.org/mtg/ontology#GameState">
    <rdfs:comment>Complete state of a game (open information)</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="http://purl.org/mtg/ontology#BeliefState">
    <rdfs:comment>Probabilistic belief about unknown information (opponent's hand, deck composition)</rdfs:comment>
  </owl:Class>

  <owl:DatatypeProperty rdf:about="http://purl.org/mtg/ontology#handProbability">
    <rdfs:domain rdf:resource="http://purl.org/mtg/ontology#BeliefState"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdfs:comment>P(card in opponent hand) given observations</rdfs:comment>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="http://purl.org/mtg/ontology#deckProbability">
    <rdfs:domain rdf:resource="http://purl.org/mtg/ontology#BeliefState"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdfs:comment>P(card in opponent deck) given observations</rdfs:comment>
  </owl:DatatypeProperty>

  <!-- Open zones (known to all players) -->
  <owl:DatatypeProperty rdf:about="http://purl.org/mtg/ontology#isOpenZone">
    <rdfs:domain rdf:resource="http://purl.org/mtg/ontology#Zone"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:comment>True if zone content is visible to all. True: Battlefield, Graveyard, Exile (face-up), Stack. False: Library, Hand, Command Zone (usually)</rdfs:comment>
  </owl:DatatypeProperty>

  <!-- Format rules (Commander vs Standard etc) -->
  <owl:Class rdf:about="http://purl.org/mtg/ontology#Format">
    <rdfs:comment>Game format: Commander, Standard, Modern, Vintage, etc.</rdfs:comment>
  </owl:Class>

  <mtg:Format rdf:about="http://purl.org/mtg/ontology#Commander">
    <rdfs:label>Commander</rdfs:label>
    <mtg:formatName>commander</mtg:formatName>
    <mtg:startingLife>40</mtg:startingLife>
    <mtg:allowedPlayers>2-4</mtg:allowedPlayers>
    <mtg:deckSize>100</mtg:deckSize>
  </mtg:Format>

  <mtg:Format rdf:about="http://purl.org/mtg/ontology#Standard">
    <rdfs:label>Standard</rdfs:label>
    <mtg:formatName>standard</mtg:formatName>
    <mtg:startingLife>20</mtg:startingLife>
    <mtg:deckSize>60</mtg:deckSize>
  </mtg:Format>

</rdf:RDF>
